{
  "name": "vercel",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "clean:ports": "lsof -ti:3000,3001,5173 | xargs kill -9 2>/dev/null || true",
    "predev": "npm run clean:ports && (redis-cli ping >/dev/null 2>&1 || brew services start redis 2>/dev/null || redis-server --daemonize yes 2>/dev/null || true) && npm run build",
    "dev": "turbo run dev",
    "postdev": "npm run clean:ports",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev:frontend": "turbo run dev --filter=frontend",
    "dev:upload": "turbo run dev --filter=upload-service",
    "dev:deploy": "turbo run dev --filter=deploy-service",
    "dev:handler": "turbo run dev --filter=request-handler"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "turbo": "latest",
    "typescript": "^7.0.0"
  },
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
